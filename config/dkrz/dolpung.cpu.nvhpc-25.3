set -eu
unset CDPATH
ulimit -c 0

script_dir=$(cd "$(dirname "$0")"; pwd)
icon_dir=$(cd "${script_dir}/../.."; pwd)

INSTALL_ROOT='/sw/spack-levante-0.23.1/linux-rhel9-neoverse_v2'
NVHPC_ROOT="${INSTALL_ROOT}/nvhpc-25.3-2i2wkyr/Linux_aarch64/25.3"
GCC_ROOT='/sw/spack-levante-0.23.1/linux-rhel9-neoverse_v2/gcc-14.2.0-am53qrz'

STDCPP_ROOT=${GCC_ROOT}
STDCPP_LIBS='-lstdc++'

MPI_ROOT="${NVHPC_ROOT}/comm_libs/12.8/openmpi4/openmpi-4.1.5"

HDF5_ROOT="${INSTALL_ROOT}/hdf5-1.14.3-igw2ryw"
HDF5_LIBS='-lhdf5_hl -lhdf5'

NETCDF_ROOT="${INSTALL_ROOT}/netcdf-c-4.9.3-osq5jdi"
NETCDF_LIBS='-lnetcdf'

NETCDFF_ROOT="${INSTALL_ROOT}/netcdf-fortran-4.6.1-iqaahe5"
NETCDFF_LIBS='-lnetcdff'

BLAS_LAPACK_LIBS='-llapack -lblas'

ECCODES_ROOT="${INSTALL_ROOT}/eccodes-2.34.0-by6vd4d"
ECCODES_LIBS='-leccodes'

FYAML_ROOT="${INSTALL_ROOT}/libfyaml-0.9-3ycnq47"
FYAML_LIBS='-lfyaml'

XML2_ROOT='/usr'
XML2_LIBS='-lxml2'

##########################################
BUILD_ENV="export LD_LIBRARY_PATH=\"${STDCPP_ROOT}/lib64:${HDF5_ROOT}/lib:${NETCDF_ROOT}/lib64:${NETCDFF_ROOT}/lib:${ECCODES_ROOT}/lib64:${FYAML_ROOT}/lib:\${LD_LIBRARY_PATH}\";"

CC="${MPI_ROOT}/bin/mpicc"
CFLAGS='-g -O2'

# Let YAC find LAPACK with the C compiler:
ICON_YAC_CFLAGS='-fortranlibs'

CXX="${NVHPC_ROOT}/compilers/bin/nvc++"
CXXFLAGS='-g -O2'

CPPFLAGS="-I${HDF5_ROOT}/include -I${NETCDF_ROOT}/include -I${ECCODES_ROOT}/include -I${FYAML_ROOT}/include -I${XML2_ROOT}/include/libxml2"


FC="${MPI_ROOT}/bin/mpifort"
FCFLAGS="-I${NETCDFF_ROOT}/include -g -O2 -Mrecursive -Mallocatable=03 -Mstack_arrays -Minfo=inline"

LDFLAGS="-L${STDCPP_ROOT}/lib64 -L${HDF5_ROOT}/lib -L${NETCDF_ROOT}/lib64 -L${NETCDFF_ROOT}/lib -L${ECCODES_ROOT}/lib64 -L${FYAML_ROOT}/lib -Wl,-rpath,${STDCPP_ROOT}/lib64 -Wl,-rpath,${HDF5_ROOT}/lib -Wl,-rpath,${NETCDF_ROOT}/lib64 -Wl,-rpath,${NETCDFF_ROOT}/lib -Wl,-rpath,${ECCODES_ROOT}/lib64 -Wl,-rpath,${FYAML_ROOT}/lib -Wl,-rpath,${GCC_ROOT}/lib64"
LIBS="-Wl,--as-needed ${STDCPP_LIBS} ${XML2_LIBS} ${FYAML_LIBS} ${ECCODES_LIBS} ${BLAS_LAPACK_LIBS} ${NETCDFF_LIBS} ${NETCDF_LIBS} ${HDF5_LIBS} "

MPI_LAUNCH="${MPI_ROOT}/bin/mpiexec"

EXTRA_CONFIG_ARGS='--disable-mpi-checks --disable-parallel-netcdf --enable-openmp --enable-bundled-python=mtime '

################################################################################

"${icon_dir}/configure" \
BUILD_ENV="${BUILD_ENV}" \
CC="${CC}" \
CFLAGS="${CFLAGS}" \
CPPFLAGS="${CPPFLAGS}" \
CXX="${CXX}" \
CXXFLAGS="${CXXFLAGS}" \
FC="${FC}" \
FCFLAGS="${FCFLAGS}" \
ICON_YAC_CFLAGS="${ICON_YAC_CFLAGS}" \
LDFLAGS="${LDFLAGS}" \
LIBS="${LIBS}" \
MPI_LAUNCH="${MPI_LAUNCH}" \
${EXTRA_CONFIG_ARGS} \
"$@"

for arg in "$@"; do
  case $arg in
    -help | --help | --hel | --he | -h | -help=r* | --help=r* | --hel=r* | --he=r* | -hr* | -help=s* | --help=s* | --hel=s* | --he=s* | -hs*)
      test -n "${EXTRA_CONFIG_ARGS}" && echo '' && echo "This wrapper script ('$0') calls the configure script with the following extra arguments, which might override the default values listed above: ${EXTRA_CONFIG_ARGS}"
      exit 0 ;;
  esac
done

# Copy runscript-related files when building out-of-source:
if test $(pwd) != $(cd "${icon_dir}"; pwd); then
  echo "Copying runscript input files from the source directory..."
  rsync -uavz ${icon_dir}/run . --exclude='*.in' --exclude='.*' --exclude='standard_*' --exclude=mkexp
  ln -sf -t run/ ${icon_dir}/run/{standard_*,mkexp}
  for dir in \
    'externals/art/runctrl_examples' \
    'externals/ecrad/data' \
    'externals/jsbach/data'
  do
    src="${icon_dir}/${dir}"
    test -d "${src}" && mkdir -p "${dir}" && rsync -uavz "${src}/" "${dir}"
  done
  rsync -uavz ${icon_dir}/make_runscripts .
  rsync -uavz ${icon_dir}/scripts .
  ln -sf ${icon_dir}/data
  ln -sf ${icon_dir}/vertical_coord_tables
fi
