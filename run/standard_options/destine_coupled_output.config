#
# DestinE output definition for coupled runs
#
VERSION_ = $$Id:standard_options/destine_coupled_output.config 0 2026-01-14 13:34:00Z k202123 $$


DESTINE_OUTPUT_ATMO_MODEL_LEVELS = "14,21,25,29,31,35,38,41,46,51,55,58,63,67,71,74,76,78,80,81,83,84,85,87,89,90"


[namelists]

  [[NAMELIST_atm]]

    [[[parallel_nml]]]
      num_io_procs = 12

    # Define output files
    # -------------------
    # Default settings for 'output_nml *'
    [[[output_nml]]]
      output_filename = ${EXP_ID}_%{id}
      filename_format = <output_filename>_<levtype_l>_<datetime2>
      filetype = 5
      mode = 1
      output_start = $INITIAL_DATE
      output_end = $FINAL_DATE
      output_interval = $OUTPUT_INTERVAL
      file_interval = $FILE_INTERVAL
      include_last = true

    [[[output_nml atm_2d_PT20M]]]
      operation = mean
      output_interval = PT20M
      file_interval = P1D
      ml_varlist = pr, qv2m, rlut, rsds, sfcwind, tas

    [[[output_nml atm_2d_PT3H]]]
      operation = mean
      output_interval = PT3H
      file_interval = P1D
      ml_varlist = clivi, cllvi, qv2m, hfls, hfss, pr, pr_rain, pr_ice, pr_snow, pr_grpl, prlr, pres_msl, pres_sfc, prls, prw, evspsbl, qgvi, qrvi, qsvi, rlds, rlus, rlut, rsds, rsdt, rsus, rsut, rsutcs, rlutcs, sfcwind, sic, sit, tas, tauu, tauv, ts, uas, vas

    [[[output_nml atm_2d_P1D]]]
      operation = mean
      ml_varlist = clivi, cllvi, qv2m, hfls, hfss, pr, pr_rain, pr_ice, pr_snow, pr_grpl, prlr, pres_msl, pres_sfc, prls, prw, evspsbl, qgvi, qrvi, qsvi, rlds, rlus, rlut, rsds, rsdt, rsus, rsut, rsutcs, rlutcs, sfcwind, sic, sit, tas, tauu, tauv, ts, uas, vas

    [[[output_nml atm_3d_P1D_1]]]
      operation = mean
      ml_varlist = ta, ua, va, hus
      m_levels = $DESTINE_OUTPUT_ATMO_MODEL_LEVELS

    [[[output_nml atm_3d_P1D_2]]]
      operation = mean
      ml_varlist = rho, clw, cli
      m_levels = $DESTINE_OUTPUT_ATMO_MODEL_LEVELS

    [[[output_nml atm_3d_P1D_3]]]
      operation = mean
      ml_varlist = qg, qr, qs
      m_levels = $DESTINE_OUTPUT_ATMO_MODEL_LEVELS

    [[[output_nml atm_3d_P1D_4]]]
      operation = mean
      ml_varlist = wa, pfull, phalf
      m_levels = $DESTINE_OUTPUT_ATMO_MODEL_LEVELS

    [[[output_nml lnd_2d_mean_PT3H]]]
      operation = mean
      output_interval = PT3H
      ml_varlist = hydro_runoff_box, hydro_discharge_box, hydro_discharge_ocean_box, hydro_evapotrans_box

    [[[output_nml lnd_2d_inst_PT3H]]]
      output_interval = PT3H
      ml_varlist = hydro_weq_snow_box, hydro_wtr_skin_box

    [[[output_nml lnd_3d_inst_PT3H]]]
      output_interval = PT3H
      ml_varlist = hydro_wtr_soil_sl_box, hydro_ice_soil_sl_box


  [[NAMELIST_oce]]

    [[[parallel_nml]]]
      num_io_procs = 2

    # Define output files
    # -------------------
    # Default settings for 'output_nml *'
    [[[output_nml]]]
      output_filename = ${EXP_ID}_%{id}
      filename_format = <output_filename>_<datetime2>
      filetype = 5
      mode = 1
      output_start = $INITIAL_DATE
      output_end = $FINAL_DATE
      output_interval = $OUTPUT_INTERVAL
      file_interval = $FILE_INTERVAL
      include_last = false

    [[[output_nml oce_ice]]]
      include_last = false
      operation = mean
      output_interval = PT6H
      ml_varlist = conc, hi, hs, ice_u, ice_v, newice

    [[[output_nml oce_lev]]]
      include_last = false
      m_levels = raw('1')
      operation = mean
      ml_varlist = to, so, u, v, ssh, mlotst, vort
