#--------------------------------------------------------------------------------------------------
#
# Settings for experiments with natural land cover change (nlcc)
#  Note: Additionally use option init_nlcc to initialize nlcc in case
#        - this is an initialized experiment, or
#        - the parent experiment was not run with dynamic vegetation

VERSION_ = $$Id: run/standard_options/land/with_nlcc.config 1 2024-11-05 16:21:20Z m221078 $$

[namelists]
  [[NAMELIST_lnd]]
    [[[jsb_nlcc_nml]]]
      active = true

  # Additional output variables
  [[NAMELIST_atm]]
    [[[output_nml lnd_basic]]]
      ml_varlist += pplcc_tree_fract_box, pplcc_shrub_fract_box, pplcc_grass_fract_box, pplcc_crop_fract_box, pplcc_pasture_fract_box, pplcc_baresoil_fract_box, pplcc_C3pft_fract_box, pplcc_C4pft_fract_box
    [[[output_nml lnd_mon]]]
      ml_varlist += pplcc_tree_area_gsum_box, pplcc_shrub_area_gsum_box, pplcc_grass_area_gsum_box, pplcc_crop_area_gsum_box, pplcc_pasture_area_gsum_box, pplcc_baresoil_area_gsum_box, pplcc_C3pft_area_gsum_box, pplcc_C4pft_area_gsum_box
