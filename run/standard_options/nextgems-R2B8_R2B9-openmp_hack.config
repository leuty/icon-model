#
# Share nodes between ocean and atmo, using asymmetric OpenMP
#
# Only valid for nextGEMS R2B8/9 setup.
# See hardcoded sections in DEFAULT.run.tmpl
#

VERSION_ = $$Id: run/standard_options/nextgems-R2B8_R2B9-openmp_hack.config 2 2025-11-14 13:51:47Z m301120 $$

[namelists]
  [[NAMELIST_atm]]
    [[[parallel_nml]]]
      num_io_procs = raw($$mpi_atm_io_procs)
  [[NAMELIST_oce]]
    [[[parallel_nml]]]
      num_io_procs = raw($$mpi_oce_io_procs)

[jobs]
  [[run]]
    use_openmp_hack = true
