#
# Minimal output settings for AMIP AES experiments
#

VERSION_ = $$Id:standard_options/amip-aes_output.config 1 2025-12-15 k202123 $$

# Output control
OUTPUT_INTERVAL = P1D
FILE_INTERVAL   = P1M

[namelists]

  [[NAMELIST_atm]]

    [[[parallel_nml]]]
      num_io_procs = 4

    # Define output files
    # -------------------
    # Default settings for 'output_nml *'
    [[[output_nml]]]
      filename_format = <output_filename>_<datetime2>
      operation = mean

    [[[output_nml atm_3d_1_qp_ml]]]
      ml_varlist = ta, ua, va, hus, pfull

    [[[output_nml atm_3d_2_qp_ml]]]
      ml_varlist = clw, cli, qr, qs, qg

    [[[output_nml atm_3d_3_qp_ml]]]
      ml_varlist = wa

    [[[output_nml atm_2d_P1D_ml]]]
      ml_varlist = tas, cllvi, clivi, hfls, hfss, pr, prw, prls, prlr, pr_rain, pr_ice, pr_snow, pr_grpl, qgvi, qrvi, qsvi, rlds, rlus, rlut, rsds, rsdt, rsus, rsut, sfcwind, sic, sit, tauu, tauv, evspsbl, uas, vas, ps, ts, psl, clt, qv2m, pres_msl, pres_sfc, cinhoml

[jobs]
  [[run]]
    num_io_tasks = 4
