# configure START_MODEL_function
#
##ICON_COMPONENT1_VH_procs=$((num_restart_procs + num_io_procs + num_prefetch_proc + num_io_procs_radar))

# Run on VH (Vector Host) only
ICON_COMPONENT1_proc0_shift=0
ICON_COMPONENT1_VE_procs=0
ICON_COMPONENT1_VH_procs=1

# ----------------------------------------------------------------------
# run the model!
# ----------------------------------------------------------------------

$START_MODEL
EXIT_STATUS=$?

echo "EXIT_STATUS: $EXIT_STATUS"
exit $EXIT_STATUS
