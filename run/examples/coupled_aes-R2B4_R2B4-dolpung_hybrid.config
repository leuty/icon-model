#
# Example config of a coupled experiment on the Levante dolpung partition (DKRZ)
# run with atm processes on the GPUs & ocean as well as IO processes on the CPUs
# of the dolpung nodes.
#
# The environment is suited for coupled experiments with same horizontal
# resolution for atmosphere and ocean. Others resolution combination lead into
# perfromance problems due to slowing down one or the other component.
#

EXP_TYPE = AES/coupled-R02B04L90
EXP_OPTIONS = output/coupled_test
ENVIRONMENT = dolpung_hybrid

## Generate experiments folders in the BUILD_DIR (refred to SRC_DIR)
#EXPERIMENTS_SUBDIR = <my_gpu_build_dir>/experiments

INITIAL_DATE = 2014-01-20
FINAL_DATE = 2014-01-20T06:00:00
INTERVAL = PT6H
FILE_INTERVAL = $INTERVAL

[jobs]
  [[run]]
    .trigger = run
    nodes = 1
    time_limit = 00:05:00
    [[[hybrid]]]
      [[[[atm]]]]
        exec = eval(feedback.die("please set atm:exec in your experiment config, eg: exec = $BUILD_DIR/bin/icon"))
      [[[[oce]]]]
        exec = eval(feedback.die("please set oce:exec in your experiment config, eg: exec = $BUILD_DIR/../my_cpu_build_dir/bin/icon"))
        cpus_per_node = 4   # maximum is 72 (default), should be a multiple of 4
