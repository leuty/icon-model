#
# coupled setup on dolpung with hiopy (output on healpix grid)
#

# Example config of a coupled experiment on the Levante dolpung partition (DKRZ)
# run with atm processes on the GPUs & ocean as well as IO processes on the CPUs
# of the dolpung nodes.
#
# !!! untuned model configuration, not for scientific use !!!
# !!! no river discharge
#
# The environment is suited for coupled experiments with same horizontal
# resolution for atmosphere and ocean. Others resolution combination lead into
# perfromance problems due to slowing down one or the other component.
#


EXP_TYPE = destine-R2B7_R2B7
EXP_OPTIONS = suppress_default_output, output/hiopy
ENVIRONMENT = dolpung_hybrid

# Change simulated time
FINAL_DATE = 1990-01-02T00:00:00Z
INTERVAL = P1D    # Restart interval

[namelists]
[[NAMELIST_atm]]
    [[[parallel_nml]]]
      nproma = 0
      nblocks_c = 1
      nproma_sub =
      nblocks_sub = 4
      num_io_procs = 0

  [[hiopy]]
    [[[atm_2d pt3h_m]]]
      variables -= o3vi
    [[[atm_3d_ml pt3h_m]]]
      .hide = true
    [[[atm_3d_pl p1d_m]]]
      variables >= ua>u, va>v

[hiopy]
  nr_of_workers = 2
  venv = eval(feedback.die("please set hiopy:venv in your experiment config, eg: venv = path/to/venv"))
  time_agg = PT3H, P1D, P10D
  [[grid]]
    type = healpix
    zoom_levels = 8, 7

[jobs]
  .remove += clean, intake, mon, mon_index, post, run, mon_log   # To suppress restart
  [[run_start]]
    .trigger =
  [[run]]
    nodes = 4
    time_limit = 00:15:00
    [[[hybrid]]]
      [[[[atm]]]]
        exec = eval(feedback.die("please set atm:exec in your experiment config, eg: exec = $BUILD_DIR/bin/icon"))
      [[[[oce]]]]
        exec = eval(feedback.die("please set oce:exec in your experiment config, eg: exec = $BUILD_DIR/../my_cpu_build_dir/bin/icon"))
        cpus_per_node = 24   # maximum is 72 (default), should be a multiple of 4
