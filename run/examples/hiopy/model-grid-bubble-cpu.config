#
#  bubble on a torus with hiopy
#

EXP_TYPE = torus
EXP_OPTIONS = suppress_default_output,output/hiopy
openmp_enabled = true
CALENDAR= proleptic gregorian

ATMO_LEVELS = 70
ATMO_TIME_STEP = PT30S
ATMO_RADIATION_TIME_STEP = PT2M

INITIAL_DATE = 2008-08-01T00:00:00Z
FINAL_DATE = 2008-08-01T02:00:00Z
INTERVAL = P1D

OUTPUT_INTERVAL = $ATMO_TIME_STEP

[namelists]
  [[NAMELIST_atm]]
    [[[aes_phy_nml]]]
      aes_phy_config(1)%dt_mig = $ATMO_TIME_STEP
    [[[nh_testcase_nml]]]
      nh_test_name = 'aes_bubble'
      ape_sst_case = 'sst_const'
      ape_sst_val = 30.0
    [[[output_nml atm_2d]]]
      ml_varlist = ps, psl, ts, clt, prw, cllvi, clivi, qrvi, qsvi, qgvi, hfls, hfss, evspsbl, prlr, prls, cptgzvi, pr_rain, pr_snow, pr_grpl, pr_ice
      operation =
      output_grid = true
    [[[output_nml atm_3d]]]
      ml_varlist = ps, pfull, zg, rho, ta, theta_v, ua, va, wa, hus, clw, cli, qr, qs, qg, cptgz
      operation =
      output_grid = true
    [[[parallel_nml]]]
      num_io_procs = 0
    [[[interpol_nml]]]
      lrbf_write = true
  [[hiopy]]
    [[[atm_2d pt3h_m]]]
      variables -= o3vi
    [[[atm_3d_ml pt3h_m]]]
      .hide = true
    [[[atm_3d_pl p1d_m]]]
      variables >= ua>u, va>v

[hiopy]
  nr_of_workers = 1
  venv = eval(feedback.die("please set hiopy:venv in your experiment config, eg: venv = path/to/venv"))
  [[grid]]
    type = icon
    [[[atmo]]]
      path_to_grid_file =eval(feedback.die("please set hiopy:grid:atmo:path_to_grid_file in your experiment config, eg: path/to/grid/icon_grid_T001_Torus_Triangles_20x4_5000m_G.nc"))

[jobs]
  [[run]]
    nodes = 1
    time_limit = 00:05:00
    use_hostfile = false
    use_cpu_mask = false
