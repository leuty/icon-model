#--------------------------------------------------------------------------------------------------
#
# Example config for a standard AMIP experiment with a standalone atmosphere
# using AES physics with the JSBACH land surface scheme and TMX turbulence
# (R02B06  for testing purposes only).
# This experiment corresponds to run/exp.aes_amip.run for the R02B06 grid
# with its default output of four files (output_atm_qp=yes).
# It serves as an editable version of the BuildBot test
# run/checksuite.atm/gpu/test_amip-aes_R2B6_gpu.config for manual execution.
#

EXP_TYPE = amip-aes-R2B6
EXP_OPTIONS = suppress_default_output, amip-aes_output

# For testing we use only short runtime
FINAL_DATE = 'add_days($INITIAL_DATE, 1)'
INTERVAL = P1D # Restart interval

[jobs]
  [[run]]
    .trigger = run
    nodes = 1
    time_limit = 00:10:00


# *** Examples of common modifications (include in the sections if required)
# ------------------------------------------------------------------------
# # Generate experiments folders in the BUILD_DIR
# SRC_DIR = $BUILD_DIR
# DATA_ROOT = $MODEL_ROOT
#
# ------------------------------------------------------------------------
# # Run on 1 GPU per node
# [jobs]
#   [[run]]
#      gpus_per_node = 1  # default: 4, set by levante_gpu.config
#
# ------------------------------------------------------------------------
# # Write no output files
# EXP_OPTIONS = suppress_default_output
#
# ------------------------------------------------------------------------
# # Disable all output and restart file writing
# [namelists]
#   [[NAMELIST_atm]]
#     [[[run_nml]]]
#       output = none
#
# ------------------------------------------------------------------------
# # Environment variable for GPU debuging
#    [[[env]]]
#      NVCOMPILER_ACC_NOTIFY = 3       # enable line-by-line tracking
#      NV_ACC_DEBUG = 1                # verbous info on devices, launches, function arguments
#      NVCOMPILER_ACC_SYNCHRONOUS = 1  # disable asyncrounous execution
