#--------------------------------------------------------------------------------------------------
#
# Example config for a standard AMIP experiment with an atmosphere
# using NWP physics with JSBACH/VDIFF land surface scheme and turbulence.
#

ENVIRONMENT  = levante
ACCOUNT      =

EXP_TYPE     = amip-nwp-R2B4

INITIAL_DATE = 1979-01-01
FINAL_DATE   = 1981-01-01
INTERVAL     = P1Y

[files]
  [[special]]
    [[[extpar]]]
      extpar_icon_grid_G.nc =
  [[temporary]]
    [[[extpar]]]
      .base_dir = /work/mh1421/m220053/for-pool/ICON/grids/public/mpim/0049/land/r0101
      extpar_icon_grid_G.nc = icon_extpar4jsbach_${ATMO_GRID_ID}_20240827_tiles_jsb.nc

[jobs]
  [[run]]
    use_mpmd     = false
    use_hostfile = false
    use_cpu_mask = false
    threads_per_task = 1
    nodes = 20
    time_limit = 00:30:00

# *** Examples of common modifications (add above the jobs section if required)
