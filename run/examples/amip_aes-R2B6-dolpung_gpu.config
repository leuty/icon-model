#--------------------------------------------------------------------------------------------------
#
# Example config for a standalone atmosphere experiment, here the
# standard AMIP experiment, on the Levante dolpung or gpu partition (DKRZ)
# runing with atm processes on the GPUs & IO processes on the CPUs
# of the nodes.
#

EXP_TYPE = amip-aes-R2B6
EXP_OPTIONS = suppress_default_output

# For testing we use a short runtime
FINAL_DATE = 'add_days($INITIAL_DATE, 1)'
INTERVAL = P1D # Restart interval

[jobs]
  [[run]]
    .trigger = run
    nodes = 1
    num_io_tasks = 2
    time_limit = 00:10:00


# *** Examples of common modifications (include in the sections if required)
# ------------------------------------------------------------------------
# # Generate experiments folders in the BUILD_DIR
# EXPERIMENTS_SUBDIR = <YOUR BUILD_DIR_PATH_RELATIVE_TO_SRC_DIR>/experiments
#
# ------------------------------------------------------------------------
# # Run on 1 GPU per node
# [jobs]
#   [[run]]
#      gpus_per_node = 1  # default: 4, set by <ENVIRONMENT>.config
#
# ------------------------------------------------------------------------
# # Disable output file writing defined in amip-aes-R2B6.config
# [namelists]
#   [[NAMELIST_atm]]
#     [[[output_nml atm_2d_P1D_ml]]]
#       .hide = true
#     [[[output_nml atm_3d_qp_ml]]]
#       .hide = true
#
# [jobs]
#   [[run]]
#      num_io_tasks = 0
#
# ------------------------------------------------------------------------
# # Disable all output and restart file writing
# [namelists]
#   [[NAMELIST_atm]]
#     [[[run_nml]]]
#       output = none
#
# [jobs]
#   [[run]]
#      num_io_tasks = 0
