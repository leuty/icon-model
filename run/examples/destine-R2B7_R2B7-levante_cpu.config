#      ocean_nodes = 4
# [MPI]
#   command = "srun -l --kill-on-bad-exit=1 --distribution=plane=$${SLURM_JOB_NUM_NODES} --hint=nomultithread --cpus-per-task=$${OMP_NUM_THREADS} --ntasks-per-node=$${mpi_procs_pernode}"
#   use_cpus_per_task = false
