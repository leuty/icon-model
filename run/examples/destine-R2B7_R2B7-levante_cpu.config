#--------------------------------------------------------------------------------------------------
#
# Example config of a coupled experiment on the Levante compute partition (DKRZ)
# run with atm, ocean and IO processes on CPUs only.
#
# !!! untuned model configuration, not for scientific use !!!
# !!! no river discharge
#

EXP_TYPE = destine-R2B7_R2B7
EXP_OPTIONS = suppress_default_output, destine_coupled_output

## Change simulated time
#INITIAL_DATE = 1979-01-01T00:00:00
#FINAL_DATE = 1979-01-01T03:00:00
#INTERVAL = PT3H

[jobs]
  [[run]]
    .trigger = run
    use_mpmd = false
    use_hostfile = false
    use_cpu_mask = false
    nodes = 20
    # Run athmosphere and ocean on the same node
    share_nodes = true
    ocean_tasks_per_node = eval("$((SLURM_JOB_NUM_NODES / 4))")

    threads_per_task = 4
    time_limit = 00:03:00


# *** Examples of common modifications (include in the sections if required)
# ------------------------------------------------------------------------
