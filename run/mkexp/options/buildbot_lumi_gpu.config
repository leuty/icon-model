#
# Settings needed for buildbot jobs on lumi_gpu
#

VERSION_ = $$Id: run/mkexp/options/buildbot_lumi_gpu.config 1 2025-08-01 12:25:44Z k202204 $$

USER = ramuelle
ACCOUNT = project_465000454

[files]
  [[buildbot]]
    $MODEL_DIR/run/LOG.${EXP_ID}.config.run.o = $LOG_DIR/$EXP_ID.run.*$$SLURM_JOB_ID.log

[jobs]
  # Use a single batch job for all runs
  [[run]]
    # move 'run' to end of list
    .trigger -= run
    .trigger += run
    batch_command = $ksh
    # dev partition for quicker turnaround
    partition = dev-g
    [[[batch]]]
      deadline = now+130minutes
  [[post,mon]]
    .type = serial
