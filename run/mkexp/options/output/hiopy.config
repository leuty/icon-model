VERSION_ = $$Id: run/mkexp/options/output/hiopy.config 1 2026-02-16 13:13:09Z m301120 $$

# In context of climate simulations with ICON,
# Hiopy defaults to writing out Zarr format 3 datasets
# and the data is on the Healpix grid

[namelists]
  [[NAMELIST_atm, NAMELIST_oce]]
    [[[coupling_mode_nml]]]
      coupled_to_output = true
  [[NAMELIST_oce]]
    [[[output_nml hiopy_oce_2d]]]
      .hide = false
  [[NAMELIST_atm]]
    [[[output_nml hiopy_atm_3d_pl]]]
      .hide = false

[hiopy]
  nr_of_workers = 4
  relative_path_to_dataset = $EXP_ID.zarr # relative to DATADIR or S3 Bucket
  storage_backend = file # or s3
  simulated_hours_per_chunk = 24
  chunks_per_shard = 1
  zarr_format = 3
  time_agg = ,
  [[storage]]
    [[s3]]
      bucket =
      endpoint_url =
  [[grid]]
    type = healpix
    zoom_levels =
    [[[atmo]]]
      path_to_grid_file =
    [[[ocean]]]
      path_to_grid_file =

[jobs]
  [[pre]]
    hiopy_configure = true
