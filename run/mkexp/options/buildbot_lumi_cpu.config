#
# Settings needed for buildbot jobs on lumi_cpu
#

VERSION_ = $$Id: run/mkexp/options/buildbot_lumi_cpu.config 1 2025-08-01 12:25:28Z k202204 $$

USER = ralfmuel
ACCOUNT = project_462000911

[files]
  [[buildbot]]
    $MODEL_DIR/run/LOG.${EXP_ID}.config.run.o = $LOG_DIR/$EXP_ID.run.*$$SLURM_JOB_ID.log

[jobs]
  # Use a single batch job for all runs
  [[run]]
    # move 'run' to end of list
    .trigger -= run
    .trigger += run
    batch_command = $ksh
    [[[batch]]]
      deadline = now+130minutes
    # dev partition for quicker turnaround
    partition = debug
  [[post,mon]]
    .type = serial
