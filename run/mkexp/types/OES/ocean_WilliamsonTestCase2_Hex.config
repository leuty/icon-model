#
# Test setup for ocean_WilliamsonTestCase2_Hex
#

EXP_TYPE = DEFAULT

VERSION_ = $$Id$$

FINAL_DATE = 2001-01-01T02:00:00Z
INITIAL_DATE = 2001-01-01T00:00:00Z
#INTERVAL = PT2H

WORK_ROOT = $DATA_ROOT

WITH_ATMO = false
WITH_LAND = false

ATMO_GRID_TYPE =
ATMO_GRID_ID =
ATMO_BLOCK_SIZE =
ATMO_TIME_STEP =
ATMO_RADIATION_TIME_STEP =

OCEAN_GRID_TYPE =
OCEAN_GRID_ID =
OCEAN_TIME_STEP = PT10M
OCEAN_BLOCK_SIZE = 16


COUPLER_TIME_STEP =

[namelists]
  [[NAMELIST_oce]]
   .remove += output_nml oce_mon, output_nml oce_P1M_2d, output_nml oce_P1M_sqr, output_nml oce_P1M_3d, output_nml oce_P1M_moc, output_nml oce_fx, ocean_gentmcwilliamsredi_nml
    [[[dbg_index_nml]]]
      dbg_lat_in = 30.0
      dbg_lon_in = -30.0
      idbg_elev = 1
      idbg_mxmn = 3
      idbg_slev = 1
      idbg_val = 0
      str_mod_tst = all
    [[[dynamics_nml]]]
    [[[grid_nml]]]
      dynamics_grid_filename = AquaPlanet_IcosDual_0158km_springOpt.nc
      use_dummy_cell_closure = true
      use_duplicated_connectivity = false
    [[[io_nml]]]
      lkeep_in_sync = true
      restart_file_type = 5
      restart_write_mode =
      write_last_restart = false
      write_initial_state = true
    [[[ocean_diagnostics_nml]]]
      diagnose_age = false
      diagnose_for_heat_content = false
      diagnose_for_horizontalvelocity = false
      diagnose_for_tendencies = false
      diagnose_green = false
      diagnostics_level = 0
      eddydiag = false
    [[[ocean_dynamics_nml]]]
      cfl_check = false
      cfl_write = false
      dzlev_m = 1.0
      fast_performance_level = 200
      iswm_oce = 1
      l_edge_based = false
      l_lhs_direct = true
      mass_matrix_inversion_type = 0
      n_zlev = 1
      select_lhs = 1
      select_solver = 40
      solver_firstguess = 2
      solver_tolerance = 1.0E-13
      use_absolute_solver_tolerance = true
      use_continuity_correction = true
    [[[ocean_forcing_nml]]]
      iforc_oce = 10
      forcing_windstress_u_type = 0
      forcing_windstress_v_type = 0
    [[[ocean_gentmcwilliamsredi_nml]]]
      gmredi_configuration = 0
    [[[ocean_horizontal_diffusion_nml]]]
      temperature_horizontaldiffusion_background = 0.0
      temperature_horizontaldiffusion_reference = 0.0
      tracerhorizontaldiffusion_scaling = 1
    [[[ocean_physics_nml]]]
      i_sea_ice = 0
    [[[ocean_tracer_transport_nml]]]
      no_tracer = 1
      fct_high_order_flux = 2
    [[[ocean_vertical_diffusion_nml]]]
      temperature_verticaldiffusion_background = 0.0
    [[[output_nml PT30M_kin ]]]
      filename_format = <output_filename>_<datetime2>
      filetype = 5
      include_last = false
      ml_varlist = zos, u, v, to, vort
      mode = 1
      output_end = $FINAL_DATE
      output_filename = ${EXP_ID}_PT30M_kin
      output_grid = true
      output_interval = PT30M
      file_interval = P1D
      output_start = $INITIAL_DATE
    [[[parallel_nml]]]
      l_fast_sum = true
      nproma = 8
      p_test_run = false
      pio_type = 0
      num_prefetch_proc = 1
    [[[run_nml]]]
      debug_check_level = 1
      modeltimestep = PT10M
      msg_timestamp = false
      output = nml
      profiling_output = 2
      timers_level = 10
    [[[sea_ice_nml]]]
      i_ice_dyn = 0
      i_ice_therm = 1
      stress_ice_zero = true
  [[NAMELIST_atm]]
  [[NAMELIST_lnd*]]
  [[icon_master.namelist]]
    [[[master_time_control_nml]]]
      experimentstartdate = $INITIAL_DATE
[files]
  [[ocean]]
    .hide = True
  [[AquaPlanets]]
    .base_dir = /pool/data/ICON/oes/grids/AquaPlanets
    .method = ln -s
    AquaPlanet_IcosDual_0158km_springOpt.nc = .
[jobs]
  .remove += clean, intake, mon, mon_index, post, run, mon_log
  [[run_start]]
    .trigger =
    nodes = 1
    time_limit = 00:10:00
    use_hostfile = false
    use_mpmd = false
  [[[namelists]]]
      [[[[icon_master.namelist]]]]
        [[[[[master_nml]]]]]
          lrestart =
      [[[[NAMELIST_oce]]]]
        [[[[[ocean_initialconditions_nml]]]]]
          initial_temperature_type = 211
          initial_velocity_type = 202
          sea_surface_height_type = 204
          topography_type = 200
