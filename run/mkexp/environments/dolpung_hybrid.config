# This environment allows to run experiments at
# the GPUs and the CPUs of the "dolpung" partition of Levante (DKRZ) by using 2 binaries.
# An example is a coupled run with the athmosphere run on the GPUs,
# while IO processes and the ocean are distributed to the CPUs of the nodes.
# It
#  - runs atm processes on all GPUs of the allocated gpu nodes
#  - for nodes > 2:
#       - use the 1st node for atm processes only, to prevent disturbance of the atm startup
#       - CPUs of the last node for IO processes only
#       - ocean runs with nodes-2
#  - for nodes = 2:
#       - CPUs of the last node for IO processes only
#       - ocean runs with nodes-1
#  - for nodes = 1:
#       - ocean and IO run on the same CPUs

VERSION_ = $$Id: run/mkexp/environments/dolpung_hybrid.config 0 2026-01-14 13:34:00Z k202123 $$

ACCOUNT = """eval("$account_" if "$account_" else feedback.die("please set ACCOUNT to your levante compute project, either in your experiment config or on the command line, or save the project name to '$HOME/.acct'"))"""

INPUT_ROOT = /pool/data
WORK_ROOT = "eval('/scratch/'+'$USER'[0]+'/$USER')"
DATA_ROOT = /work/$PROJECT_SUBDIR/$USER


[jobs]
  ldd = ldd
  batch_command = sbatch
  progress_command = sh -c 'scontrol update JobId=$$SLURM_JOB_ID Comment="$$*"' scomment
  ksh = /bin/bash

  # Environment variables for job information
  name_environ = SLURM_JOB_NAME
  id_environ = SLURM_JOBID

  # Hardware parameters
  default_gpus_per_node = 4    # = 4 sockets/node x 1 GPUs/socket
  default_cpus_per_node = 288  # = 4 sockets/node x 72 CPU cores/socket
  default_cpu_threads_per_task = 4
  hardware_threads =

  [[run]]
    use_gpus = true
    use_cpu_mask = false
    use_hostfile = true
    use_mpmd = true
    partition = dolpung
    nodes = 1
    stack_size = unlimited
    [[[env]]]
      # OpenMP
      OMP_DYNAMIC = false
      OMP_SCHEDULE = guided
      OMP_STACKSIZE = 500M
      # Unified Communication X
      UCX_HANDLE_ERRORS = bt
      # OpenMPI
      OMPI_MCA_btl = self
      OMPI_MCA_coll = "^hcoll,ml"
      OMPI_MCA_io = romio321
      OMPI_MCA_osc = ucx
      OMPI_MCA_pml = ucx
      # NVIDIA
      CUDA_BUFFER_PAGE_IN_THRESHOLD_MS = 0.001
      NVCOMPILER_ACC_DEFER_UPLOADS = 1
      NVCOMPILER_TERM = trace
      NVCOMPILER_ACC_USE_GRAPH = 1
      # Jemalloc
      MALLOC_CONF = thp:never
    [[[hybrid]]]
      [[[[atm]]]]
        exec = $SRC_DIR/bin/icon-gpu
        gpus_per_node = $default_gpus_per_node
      [[[[oce]]]]
        exec = $SRC_DIR/bin/icon
        cpus_per_node = $default_cpus_per_node
        [[[[[env]]]]]
          OMP_NUM_THREADS = $default_cpu_threads_per_task
          ICON_THREADS = $OMP_NUM_THREADS
          OMP_WAIT_POLICY = active
          UCX_TLS = 'ib,shm,self'
    [[[batch]]]
      reservation = dolpung


  [[mon]]
    partition = shared

  [[clean]]
    partition = compute
    tasks = 128
    time_limit = 30

  [[intake]]
    python3 = /usr/bin/env python3

[MPI]
  # Set cpus_per_task very large to make sure that overcommit works and gives us all available cores even though we only have 68 tasks
  command = "srun -l --mem=0 --export=ALL --cpus-per-task=64 --threads-per-core=2 --cpu-bind=none --overcommit"
