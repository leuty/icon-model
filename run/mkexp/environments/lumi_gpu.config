VERSION_ = $$Id: run/mkexp/environments/lumi_gpu.config 1 2025-08-01 12:23:35Z k202204 $$

INPUT_ROOT = /appl/local/climatedt/pool/data
WORK_ROOT = /scratch/$PROJECT_SUBDIR/$USER
DATA_ROOT = /scratch/$PROJECT_SUBDIR/$USER

# Blocking parameter for grid decomposition
#  nproma for ATMO and OCEAN,      ICON default: 1 if nblocks_c and nblocks_e are not set
DEFAULT_ATMO_NPROMA =
DEFAULT_OCEAN_NPROMA =
#  nproma_sub for radiation,       ICON default: computed based on nblocks_sub
DEFAULT_ATMO_NPROMA_SUB =
#  nblocks_c for ATMO and OCEAN,   ICON default: 0
DEFAULT_ATMO_NBLOCKS_C = 1
DEFAULT_OCEAN_NBLOCKS_C = 1
#  nblocks_sub used for radiation, ICON default: 1 if nproma_sub not set
DEFAULT_ATMO_NBLOCKS_SUB = 6

# Distribution of the IO tasks among the CPUs of the GPU nodes
#  it calculate num_io_procs based on choosen number of nodes and num_io_tasks
IO_DISTRIBUTION_OVER_GPUS = true
[namelists]
  [[NAMELIST_atm]]
    [[[parallel_nml]]]
      num_io_procs = raw($${num_io_procs})

[jobs]

  batch_command = sbatch
  progress_command = sh -c 'scontrol update JobId=$$SLURM_JOB_ID Comment="$$*"' scomment
  hostnames_command = scontrol show hostnames "$$SLURM_NODELIST"
  ksh = /bin/bash

  # Environment variables for job information
  name_environ = SLURM_JOB_NAME
  id_environ = SLURM_JOBID

  # Hardware parameters
  hardware_threads = true
  default_threads_per_task = 1
  default_cpus_per_node = 128
  default_gpus_per_node = 8

  [[run]]
    use_gpus = true
    use_cpu_mask = false   # binding to numa domains in run_wrapper_lumi_gpu.tmpl
    use_hostfile = true
    use_mpmd = false       # no --multi-prog icon_mpmd.conf
    partition = standard-g
    nodes = 1
    stack_size = unlimited
    [[[env]]]
      # MPI-related
      FI_MR_CACHE_MONITOR = memhooks
      MPICH_OFI_NIC_POLICY = GPU
      MPICH_GPU_SUPPORT_ENABLED = 1
      # Process binding is handled by 'run_wrapper_lumi_gpu.tmpl', here we just
      # enable verbose information.
      SLURM_CPU_BIND = 'verbose'

  [[mon]]
    partition = small

  [[clean]]
    partition = small
    tasks = 128
    time_limit = 30

  [[intake]]
    python3 = /usr/bin/env python3

[MPI]
  command = "srun -l --kill-on-bad-exit=1 --export=ALL --gpus-per-node=$$gpus_per_node"
