#=============================================================================
# Testbed for communication routines (communication_orig)
#=============================================================================
# the namelist filename
testbed_namelist=NAMELIST_${EXPNAME}
#
#-----------------------------------------------------------------------------
start_date="2000-01-01T00:00:00Z"
  end_date="2000-01-03T00:00:00Z"

grids_folder="${icon_data_rootFolder:-/pool/data/ICON}/grids/public/edzw/"
atmo_dyn_grids="icon_grid_0012_R02B04_G.nc"
atmo_dyn_rbf_coeffs="${atmo_dyn_grids%.nc}-rbf_coeffs.nc"

# Using MPI-M grid repository as backup if grid files not on file system, browse via url:
#   http://icon-downloads.mpimet.mpg.de/
GRID_BASE_URL='http://icon-downloads.mpimet.mpg.de/grids/public/edzw'
# Using public swift server as backup if rbf files not on file system, browse via url:
#   https://swiftbrowser.dkrz.de/public/dkrz_ab6243f85fe24767bb1508712d1eb504/buildbot-grid_files
RBF_BASE_URL='https://swift.dkrz.de/v1/dkrz_ab6243f85fe24767bb1508712d1eb504/buildbot-grid_files'
lrbf_read=.TRUE.

#-----------------------------------------------------------------------------
# write ICON namelist parameters
# input: namelist_filename
# ------------------------
# For a complete list see Namelist_overview and Namelist_overview.pdf
#
create_namelist()
{
namelist_filename=$1
cat > $namelist_filename << EOF
&testbed_nml
  testbed_model       = 9
  testbed_iterations  = 100
  calculate_iterations  = 0
/
&parallel_nml
 iorder_sendrecv = 1
 nproma          = 16
 num_io_procs    = ${num_io_procs}
 io_proc_chunk_size   = 46
 io_process_stride    = 8
 use_icon_comm   = .true.
 default_comm_pattern_type = 1
 ! icon_comm_method = ${icon_comm_method}
 ! max_send_recv_buffer_size = ${max_send_recv_buffer_size}
 ! max_mpi_message_size = ${max_mpi_message_size}
 p_test_run     = .false.
 l_test_openmp  = .false.
 l_log_checks   = .false.
 l_fast_sum     = .true.
 ! division_method=1
 ! division_file_name="$division_file_name"
 ! parallel_radiation_mode=$parallel_radiation_mode
 use_dycore_barrier = .false.
 ! test_parallel_radiation = .true.
 ! icon_comm_debug = .true.
/
&grid_nml
 dynamics_grid_filename = "${atmo_dyn_grids}",
/
&gridref_nml
/
&run_nml
 num_lev     = 40,        ! number of full levels of vertical grid
 ntracer     = 0          ! number of tracers
 nsteps      = 40         ! [day] length of run
 dtime       = 300        ! [s] timestep
 ldynamics   = .TRUE.       ! dynamics
 ltransport  = .FALSE.      ! transport
 iforcing    = 0            ! no forcing
 ltestcase   = .TRUE.       ! run testcase
 ltimer = .true.
 timers_level = 100
 activate_sync_timers = .true.
 profiling_output = 2
 output      = 'none'
/
&testcase_nml
 ctest_name  = 'JWw'        ! test case identifier
/
&diffusion_nml
/
&transport_nml
/
&interpol_nml
 lrbf_read              = ${lrbf_read}
 rbf_coeffs_filename    = "${atmo_dyn_rbf_coeffs}",
/
EOF
}
#-----------------------------------------------------------------------------

#-----------------------------------------------------------------------------
create_namelist $testbed_namelist
run_atmo="true"
#-----------------------------------------------------------------------------
#-----------------------------------------------------------------------------
null_namelist="NAMELIST_null_${EXPNAME}"
cat > ${null_namelist} << EOF
&testbed_nml
  testbed_model = 0
/
EOF
