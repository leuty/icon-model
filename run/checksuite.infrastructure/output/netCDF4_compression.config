#
# Test setup for the NetCDF-4 compresion features
#
#  It is based on the bubble experiment on a torus
#

EXP_TYPE = torus

ATMO_LEVELS = 70
ATMO_TIME_STEP = PT30S
ATMO_RADIATION_TIME_STEP = PT2M

INITIAL_DATE = 2008-08-01T00:00:00Z
FINAL_DATE = 2008-08-01T02:00:00Z
INTERVAL = P1D

OUTPUT_INTERVAL = $ATMO_TIME_STEP

# This should be in the buildbot option but currently environment takes precedence
WORK_ROOT = $MODEL_ROOT
DATA_ROOT = $MODEL_ROOT

# Disable default compression for this test
WRITE_COMPRESSION=

[namelists]
  [[NAMELIST_atm]]
    [[[aes_phy_nml]]]
      aes_phy_config(1)%dt_mig = $ATMO_TIME_STEP
    [[[nh_testcase_nml]]]
      nh_test_name = 'aes_bubble'
      ape_sst_case = 'sst_const'
      ape_sst_val = 30.0

    [[[output_nml]]]
      operation =
      output_grid = true

    [[[output_nml atm_2d]]]
      ml_varlist = ps, psl, ts, clt, prw, cllvi, clivi, qrvi, qsvi, qgvi, hfls, hfss, evspsbl, prlr, prls, cptgzvi, pr_rain, pr_snow, pr_grpl, pr_ice
    [[[output_nml atm_2d_filter_zstd]]]
      ml_varlist = ps, psl, ts, clt, prw, cllvi, clivi, qrvi, qsvi, qgvi, hfls, hfss, evspsbl, prlr, prls, cptgzvi, pr_rain, pr_snow, pr_grpl, pr_ice
      filter_spec = '32015,6'             # Compression algorithm zstd with compression level 6
    [[[output_nml atm_2d_filter_blosc]]]
      ml_varlist = ps, psl, ts, clt, prw, cllvi, clivi, qrvi, qsvi, qgvi, hfls, hfss, evspsbl, prlr, prls, cptgzvi, pr_rain, pr_snow, pr_grpl, pr_ice
      filter_spec = '32001,0,0,0,0,5,2,1' # Compression algorithm blosc with lz4 filter, compression level 5 and bitshuffle

    [[[output_nml atm_3d]]]
      ml_varlist = ps, pfull, zg, rho, ta, theta_v, ua, va, wa, hus, clw, cli, qr, qs, qg, cptgz
    [[[output_nml atm_3d_zstd]]]
      ml_varlist = ps, pfull, zg, rho, ta, theta_v, ua, va, wa, hus, clw, cli, qr, qs, qg, cptgz
      filter_spec = '32015,6'             # Compression algorithm zstd with compression level 6

    [[[output_nml atm_3d_compressionrate_low]]]
      ml_varlist = ps, pfull, zg, rho, ta, theta_v, ua, va, wa, hus, clw, cli, qr, qs, qg, cptgz
      filter_spec = '32015,6'             # Compression algorithm zstd with compression level 6
      number_of_bits = 16                 # compression rate for 16 is verry low
    [[[output_nml atm_3d_compressionrate_high]]]
      ml_varlist = ps, pfull, zg, rho, ta, theta_v, ua, va, wa, hus, clw, cli, qr, qs, qg, cptgz
      filter_spec = '32015,6'             # Compression algorithm zstd with compression level 6
      number_of_bits = 13                 # compression rate of 13 is higher and need to be checked by the user if accaptable

    [[[output_nml atm_3d_2chunks]]]
      ml_varlist = ps, pfull, zg, rho, ta, theta_v, ua, va, wa, hus, clw, cli, qr, qs, qg, cptgz
      filter_spec = '32015,6'             # Compression algorithm zstd with compression level 6
      chunk_size = 80                     # Devision into 2 chunks (based on ncells)

    [[[output_nml atm_2d_falsetest0]]]
      ml_varlist = ps, psl, ts, clt, prw, cllvi, clivi, qrvi, qsvi, qgvi, hfls, hfss, evspsbl, prlr, prls, cptgzvi, pr_rain, pr_snow, pr_grpl, pr_ice
    [[[output_nml atm_2d_falsetest1]]]
      ml_varlist = ps, psl, ts, clt, prw, cllvi, clivi, qrvi, qsvi, qgvi, hfls, hfss, evspsbl, prlr, prls, cptgzvi, pr_rain, pr_snow, pr_grpl, pr_ice
    [[[output_nml atm_2d_falsetest2]]]
      ml_varlist = ps, psl, ts, clt, prw, cllvi, clivi, qrvi, qsvi, qgvi, hfls, hfss, evspsbl, prlr, prls, cptgzvi, pr_rain, pr_snow, pr_grpl, pr_ice
    [[[output_nml atm_2d_falsetest3]]]
      ml_varlist = ps, psl, ts, clt, prw, cllvi, clivi, qrvi, qsvi, qgvi, hfls, hfss, evspsbl, prlr, prls, cptgzvi, pr_rain, pr_snow, pr_grpl, pr_ice
    [[[output_nml atm_2d_falsetest4]]]
      ml_varlist = ps, psl, ts, clt, prw, cllvi, clivi, qrvi, qsvi, qgvi, hfls, hfss, evspsbl, prlr, prls, cptgzvi, pr_rain, pr_snow, pr_grpl, pr_ice


[jobs]
  [[run]]
    nodes = 1
    time_limit = 00:05:00
    use_hostfile = false
    use_mpmd = false
  [[run_start]]
    .trigger = check_file_size    # Add the testing script at the end of the experiment
  [[check_file_size]]
    .var_format = {%s}
    .type = serial                # Start the itesting script as part of the .run_start slurm job
    debug_level = 2               # Debubing level: 0 - INFO; >0 - DEBUG

    [[[atm_2d]]]
      min_size = 6.1M
      max_size = 6.5M
    [[[atm_2d_filter_zstd]]]
      min_size = 1.9M
      max_size = 2.3M
    [[[atm_2d_filter_blosc]]]
      min_size = 3.1M
      max_size = 3.5M

    [[[atm_3d]]]
      min_size = 396K
      max_size = 316G
    [[[atm_3d_zstd]]]
      min_size = 121M
      max_size = 141M
    [[[atm_3d_compressionrate_low]]]
      min_size = 41M
      max_size = 61M
    [[[atm_3d_compressionrate_high]]]
      min_size = 37M
      max_size = 57M
    [[[atm_3d_2chunks]]]
      min_size = 148M
      max_size = 168M

    [[[atm_2d_falsetest0]]]
      min_size = 6.1P  # wrong unit
      max_size = 6.5K
      expected_fail = true
    [[[atm_2d_falsetest1]]]
      min_size = 6.1B # shrink too much
      max_size = 6.5B
      expected_fail = true
    [[[atm_2d_falsetest2]]]
      min_size = 6.1T # raise too much
      max_size = 6.5T
      expected_fail = true
    [[[atm_2d_falsetest3]]]
      min_size = 6.5M  # bullshit user input
      max_size = 6.1M
      expected_fail = true
    [[[atm_2d_falsetest4]]]
      min_size = 6.1M # possible questionable user input
      max_size = 6.1M
      expected_fail = true
