#
# Test setup for amip nwp experiment with ComIn
#
# Defaults are set for use in buildbot
#

EXP_TYPE = amip-nwp-R2B4

INITIAL_DATE    = 1979-01-01
FINAL_DATE      = 1979-01-01T06:00:00

WITH_LAND = FALSE

[namelists]
  [[NAMELIST_atm]]
    [[[run_nml]]]
      ltestcase = true # allow running without surface
      timers_level = 3 # enable comin timers
    [[[comin_nml]]]
      "plugin_list(1)%name" = "simple_python_plugin"
      "plugin_list(1)%plugin_library" = "${BUILD_DIR}/externals/comin/build/_icon/plugins/python_adapter/libpython_adapter.so"
      "plugin_list(1)%options" = "${MODEL_ROOT}/${MODEL_SUBDIR}/externals/comin/plugins/python_adapter/test/halo_sync_test.py"
    [[[nwp_phy_nml]]]
      inwp_surface      = 0
      inwp_radiation    = 0
      inwp_turb         = 1 # 6: VDIFF, 1: turbtran
    [[[lnd_nml]]]
      sstice_mode     = 1
    [[[output_nml atm_2d]]]
      .hide = true
    [[[output_nml atm_3d]]]
      .hide = true
    [[[output_nml atm_mon]]]
      .hide = true

[jobs]
  [[run]]
    .trigger = run
