components:
  atmo_output:
    model: ICON
    simulated: atmosphere
    grid: icon_atmos_grid
    time:
      step: %{atmo.timestep}
      lag: %{atmo.lag|d(1)}
  ocean_output:
    model: ICON
    simulated: ocean
    grid: icon_ocean_grid
    time:
      step: %{ocean.timestep}
      lag: %{ocean.lag|d(1)}
dates:
  start: "$start_date"
  end: "$next_date"
  calendar: "%{calendar}"
