#
# ICON experiment configuration
#

VERSION_ = $$Id: run/standard_experiments/destine-R2B7_R2B7.config 1 2026-02-27 12:54:40Z k202123 $$

# General setup

PROJECT = DestinE

# Pathes to start the ocean from climatology
PARENT_ROOT = $INPUT_DIR/$OCEAN_GRID_ID
PARENT_SUBDIR = ocean/initial_conditions
PARENT_EXP_ID = ts_phc3.0_annual_icon_icon_grid_0062_R02B07_O_L72
PARENT_DATE =

SCENARIO = ssp370

# Atmosphere setup

WITH_ATMO = true
ATMO_GRID_ID = 0061
ATMO_GRID_TYPE = R02B07
ATMO_LEVELS = 90

ATMO_TIME_STEP = PT2M
ATMO_RADIATION_TIME_STEP = PT10M
ATMO_DYNAMICS_SUBSTEPS = 5

ATMO_USE_TMX = true

# Land setup

WITH_LAND = true
LAND_WITH_HD = $WITH_LAND # use hydrological discharge (hd) model
LAND_WITH_LAKES = $WITH_LAND # use lake model in jsbach
LAND_USECASE = jsbach_lite
LAND_REFERENCE_YEAR =
LAND_WITH_CARBON = false

# Ocean setup

OCEAN_INPUT_SUBDIR = $INPUT_SUBDIR
OCEAN_GRID_ID = 0062
OCEAN_GRID_TYPE = R02B07
OCEAN_LAYER_DEPTHS = "2.0, 2.2, 2.5, 2.8, 3.1, 3.5, 3.9, 4.4, 4.9, 5.4, 5.9, 6.4, 7.1, 7.7, 8.4, 9.2, 10.1, 11.0, 12.0, 13.2, 14.4, 15.7, 17.1, 18.7, 20.4, 22.3, 24.3, 26.5, 28.9, 31.5, 34.3, 37.3, 40.6, 43.1, 45.3, 46.8, 48.4, 50.0, 51.7, 53.4, 55.2, 57.0, 58.9, 60.8, 62.9, 66.6, 72.6, 80.6, 90.6, 100.2, 110.0, 120.3, 128.7, 137.4, 146.4, 155.7, 165.2, 174.8, 184.4, 194.1, 203.6, 212.9, 221.9, 230.5, 238.5, 245.9, 252.4, 258.1, 262.8, 266.4, 268.9, 270.1"


OCEAN_TIME_STEP = PT5M

# Ocean biogeochemistry setup

WITH_OBGC = false

# Coupling setup

COUPLER_TIME_STEP = PT10M

# Time control

INITIAL_DATE = 1990-01-01T00:00:00Z
FINAL_DATE = 2020-12-31T00:00:00Z
INTERVAL = P2D

FILE_INTERVAL = P1M
OUTPUT_INTERVAL = P1D

[namelists]

  [[icon_master.namelist]]
    [[[master_time_control_nml]]]
      experimentstartdate = $INITIAL_DATE

    [[[master_nml]]]
      lrestart = false
      read_restart_namelists = false

    [[[time_nml]]]
      is_relative_time = true

    [[[jsb_control_nml]]]
      debug_level = 0
      is_standalone = false
      restart_jsbach = false
      timer_level = 0

  [[coupling.yaml]]
    river_runoff_spread = 0.3



  [[NAMELIST_atm]]
    [[[coupling_mode_nml]]]
      coupled_to_ocean = true
    [[[parallel_nml]]]
      nblocks_sub = eval( '4' if ('$gpu_enabled' == 'true') else '$DEFAULT_ATMO_NBLOCKS_SUB')
      num_io_procs = 1
      num_restart_procs = raw($$((mpi_atm_procs/8)))
      pio_type = 1
      io_proc_chunk_size = 46
      io_process_stride = 8
      iorder_sendrecv = 3
    [[[dynamics_nml]]]
      .hide = true
    [[[run_nml]]]
      activate_sync_timers = true
      iforcing = 2
      ldynamics = true
      ltestcase = false
      ltransport = true
      modeltimestep = $ATMO_TIME_STEP
      msg_level = 10
      num_lev = 90
      output = nml
      profiling_output = 1
      timers_level = 10
      restart_filename = ${EXP_ID}_restart_atm_<rsttime>.mfr
    [[[extpar_nml]]]
      itopo = 1 # 1: read topography from the grid file
      itype_lwemiss =
    [[[nonhydrostatic_nml]]]
      damp_height = 40000. # [m]
      rayleigh_coeff = 1.0
      vwind_offctr = 0.2
      divdamp_fac = 0.004
      divdamp_order = 24
      divdamp_trans_end = 17500
      divdamp_trans_start = 12500
      divdamp_type = 32
      exner_expol = 0.333
      hbot_qvsubstep = 16000.
      htop_moist_proc = 22500.
      iadv_rhotheta = 2
      igradp_method = 3
      itime_scheme = 4
      ivctype = 2
      l_zdiffu_t = true
      thhgtd_zdiffu = 125.
      thslp_zdiffu = 0.02
    [[[interpol_nml]]]
      .hide = true
    [[[sleve_nml]]]
      min_lay_thckn = 25.  # [m]
      max_lay_thckn = 400. # [m]
      top_height = 75000.  # [m]
      stretch_fac = 0.9
      decay_scale_1 = 4000. # [m]
      decay_scale_2 = 2500. # [m]
      decay_exp = 1.2
      flat_height = 22500.
      htop_thcknlimit = 14000.
    [[[aes_cop_nml]]]
      aes_cop_config(1)%cinhomi = eval('0.6' if is_set('$ATMO_USE_TMX') else '1.0')
      aes_cop_config(1)%cinhoml_cfl = 0.5
      aes_cop_config(1)%cinhoml_cfo = 0.5
      aes_cop_config(1)%cinhoml_sf = 0.725
      aes_cop_config(1)%cn1lnd = 50.0
      aes_cop_config(1)%cn1sea = 50.0
      aes_cop_config(1)%cn2lnd = 220.0
      aes_cop_config(1)%cn2sea = 100.0
    [[[aes_cov_nml]]]
      aes_cov_config(1)%cqx = 1.e-6
    [[[aes_phy_nml]]]
      aes_phy_config(1)%dt_rad = $ATMO_RADIATION_TIME_STEP
      aes_phy_config(1)%dt_vdf = $ATMO_TIME_STEP
      aes_phy_config(1)%dt_mig = $ATMO_TIME_STEP
      aes_phy_config(1)%llake = eval('false' if is_set('$ATMO_USE_TMX') else '$LAND_WITH_LAKES')
      aes_phy_config(1)%lamip = false
      aes_phy_config(1)%lmlo = false
      aes_phy_config(1)%use_shflx_adjustment = eval('false' if is_set('$ATMO_USE_TMX') else 'true')
      aes_phy_config(1)%iqneg_d2p = 2
      aes_phy_config(1)%iqneg_p2d = 2
      aes_phy_config(1)%l2moment  =
    [[[aes_rad_nml]]]
      aes_rad_config(1)%irad_ch4 = 12
      aes_rad_config(1)%irad_n2o = 12
      aes_rad_config(1)%irad_o3 = 5
      aes_rad_config(1)%isolrad = 6
      aes_rad_config(1)%irad_cfc11 = 2
      aes_rad_config(1)%irad_cfc12 = 2
      aes_rad_config(1)%irad_aero = 13
      aes_rad_config(1)%vmr_co2 = 354.07e-06
      aes_rad_config(1)%vmr_ch4 = 1717.40e-09
      aes_rad_config(1)%vmr_n2o = 308.68e-09
      aes_rad_config(1)%vmr_cfc11 = 263.09e-12
      aes_rad_config(1)%vmr_cfc12 = 482.76e-12
      aes_rad_config(1)%lyr_perp = true
      aes_rad_config(1)%yr_perp = 1990
    [[[aes_vdf_nml]]]
      aes_vdf_config(1)%dissipation_factor = eval('1.3' if is_set('$ATMO_USE_TMX') else '')
      aes_vdf_config(1)%energy_type = 2 # Only used for tmx
      aes_vdf_config(1)%min_sfc_wind = 4.
      aes_vdf_config(1)%pr0 = 0.7
      aes_vdf_config(1)%turb = eval('2' if is_set('$ATMO_USE_TMX') else '1')
      aes_vdf_config(1)%use_tmx = $ATMO_USE_TMX
      aes_vdf_config(1)%lcuda_graph_vdf = eval('True' if ('$ENVIRONMENT' == 'levante_gpu') else 'True' if ('$ENVIRONMENT' == 'dolpung_hybrid') else 'False')
    [[[transport_nml]]]
      ihadv_tracer = 20, 20, 20, 20, 20, 20
      itype_hlimit = 3, 4, 4, 4, 4, 4
      ivadv_tracer = 3, 3, 3, 3, 3, 3
      tracer_names = hus, clw, cli, qr, qs, qg

    # Parameters for all output files
    # -------------------------------
    [[[io_nml]]]
      itype_rh = 1
      restart_write_mode = joint procs multifile
      write_initial_state =
      write_last_restart =
    [[[dbg_index_nml]]]
      .hide = true

  [[NAMELIST_lnd]]
    [[[jsb_model_nml]]]
      usecase = $LAND_USECASE
      use_lakes = $LAND_WITH_LAKES
      use_tmx = $ATMO_USE_TMX
      init_from_ifs = true
      fract_filename = bc_land_frac.nc
    [[[jsb_seb_nml]]]
      bc_filename = bc_land_phys.nc
      ic_filename = ic_land_soil.nc
    [[[jsb_rad_nml]]]
      use_alb_veg_simple = eval('$LAND_USECASE' == 'jsbach_lite')
      bc_filename = bc_land_phys.nc
      ic_filename = ic_land_soil.nc
    [[[jsb_turb_nml]]]
      bc_filename = bc_land_phys.nc
      ic_filename = ic_land_soil.nc
      max_ini_rough_m = eval('1.0' if is_set('$ATMO_USE_TMX') else '-1.0')
    [[[jsb_sse_nml]]]
      l_heat_cap_map = false
      l_heat_cond_map = false
      l_heat_cap_dyn = false
      l_heat_cond_dyn = false
      l_dynsnow = true
      l_freeze = true
      l_supercool = false
      l_soil_texture = false
      bc_filename = bc_land_soil.nc
      ic_filename = ic_land_soil.nc
    [[[jsb_hydro_nml]]]
      l_organic = false
      bc_filename = bc_land_soil.nc
      ic_filename = ic_land_soil.nc
      bc_sso_filename = bc_land_sso.nc
      l_read_initial_moist = true
      l_socmap = false
      l_soil_texture = false
      snow_depth_max = 10.0
    [[[jsb_assimi_nml]]]
      active = eval('$LAND_USECASE' != 'jsbach_lite')
    [[[jsb_pheno_nml]]]
      scheme = eval('climatology' if '$LAND_USECASE' == 'jsbach_lite' else 'logrop')
      bc_filename = bc_land_phys.nc
      ic_filename = ic_land_soil.nc
    [[[jsb_carbon_nml]]]
      active = $LAND_WITH_CARBON
      bc_filename = bc_land_carbon.nc
      ic_filename = ic_land_carbon.nc
      read_cpools = false
    [[[jsb_fuel_nml]]]
      active = $LAND_WITH_CARBON
      fuel_algorithm = 1
    [[[jsb_disturb_nml]]]
      active = $LAND_WITH_CARBON
      ic_filename = ic_land_soil.nc
      bc_filename = bc_land_phys.nc
      fire_algorithm = 1
      windbreak_algorithm = 1
      lburn_pasture = false
    [[[jsb_hd_nml]]]
      active = $LAND_WITH_HD
      routing_scheme = full # 'zero': simple scheme with zero runoff everywhere
      diag_water_budget = true
      enforce_water_budget = ignore
      read_initial_reservoirs = true
      use_bifurcated_rivers = true
      bc_filename = bc_land_hd.nc
      ic_filename = ic_land_hd.nc
      debug_hd = false

  [[NAMELIST_oce]]
    [[[coupling_mode_nml]]]
      coupled_to_atmo = $WITH_ATMO
    [[[parallel_nml]]]
      iorder_sendrecv = 3
      nproma = eval( '$DEFAULT_OCEAN_NPROMA' if ('$gpu_enabled' == 'true') else '32')
      num_io_procs = 1
      num_prefetch_proc = 0
      pio_type = 1
      l_fast_sum = false
      io_proc_chunk_size = 37
      num_restart_procs = raw($$((mpi_oce_procs/8)))
      p_test_run = false

    [[[dbg_index_nml]]]
      dbg_lat_in = 30.0
      dbg_lon_in = -30.0
      idbg_elev = 5
      idbg_mxmn = 0
      idbg_slev = 1
      idbg_val = 0
      str_mod_tst = all
    [[[grid_nml]]]
      dynamics_grid_filename = icon_grid_O.nc
      use_dummy_cell_closure = true
      use_duplicated_connectivity = false
    [[[run_nml]]]
      modeltimestep = $OCEAN_TIME_STEP
      output = nml # namelist controlled output scheme
      activate_sync_timers = true
      profiling_output = 1 # aggregated: 1; detailed: 2; in files: 3
      msg_timestamp = false
      msg_level = 10
      timers_level = 10
      debug_check_level = 1
      restart_filename = ${EXP_ID}_restart_oce_<rsttime>.nc
    [[[ocean_dynamics_nml]]]
      n_zlev = $OCEAN_LEVELS
      dzlev_m = eval([$OCEAN_LAYER_DEPTHS])
      l_edge_based = false # edge- or cell-based mimetic discretization
      select_solver = 4 # 1=gmres_oce_old; 2=ocean_restart_gmres, 3=mixed precisison restart, 4=CG (default) 5=CGJ 6=BiCG 7=GMRES restart (legacy) 8=MINRES
      solver_max_iter_per_restart = 14
      solver_max_restart_iterations = 100
      solver_tolerance = 1.0E-10
      use_absolute_solver_tolerance = true
      solver_firstguess =
      fast_performance_level = 200 # performance level 12: for cell-based; 5: default
      use_continuity_correction = true # height adjustment according to vertical velocity in dynamics
      cfl_check = false
      cfl_write = false
      i_bc_veloc_top = 1
      i_bc_veloc_bot = 1 # 0: (def) bottom friction off, 1: on
      l_lhs_direct = false
      l_partial_cells = false
      minverticallevels = 10
      select_lhs = 1
      vert_cor_type = 1
    [[[ocean_tracer_transport_nml]]]
      flux_calculation_horz = 5 # 1=upwind, 2=central, 3=Lax-Friedrichs, 4=Miura, 5=FCT with Zalesak limiter (default)
      flux_calculation_vert = 7 # 6=adpo; 7=upwind biased ppm (default); 8=FCT with Zalesak limiter
      fct_low_order_flux = 1 # horizontal low  order method: 1=upwind (def), no other implemented
      fct_high_order_flux = 5 # horizontal high order method: 1=upwind, 2=central, 3=lax_friedrichs, 4=miura_order1
      fct_limiter_horz = 100 # Zalesak
      threshold_min_t = -2.0
    [[[ocean_horizontal_diffusion_nml]]]
      laplacian_form = 1 # 1=curlcurl-graddiv
      velocitydiffusion_order = 2 # 1=laplacian (def); 2=biharmonic; 21=biharmonic+laplacian (for the laplacian leith)
      harmonicviscosity_scaling = 1
      harmonicviscosity_reference = 2.0 # [m2/s] constant horizontal viscosity coefficient for velocity
      harmonicviscosity_background =
      tracerhorizontaldiffusion_scaling = 1
      biharmonicviscosity_background = 0.0
      biharmonicviscosity_reference = 2.7E-2
      biharmonicviscosity_scaling = 4
      temperature_horizontaldiffusion_background = 0.0
      temperature_horizontaldiffusion_reference = 0
      salinity_horizontaldiffusion_background = 0.0
      salinity_horizontaldiffusion_reference = 0
    [[[ocean_vertical_diffusion_nml]]]
      alpha_tke = 30.0
      c_eps = 0.7
      c_k = 0.1
      cd = 3.75
      clc = 0.15
      kappam_max = 100.0
      kappam_min = 0.0
      l_lc = true
      mxl_min = 1.D-8
      only_tke = true
      ppscheme_type = 0
      tke_min = 1.D-6
      tke_mxl_choice = 2
      tke_surf_min = 1.d-4
      use_lbound_dirichlet = false
      use_ubound_dirichlet = false
      vert_mix_type = 2
      velocity_verticaldiffusion_background =  # [m2/s]  vertical background viscosity coefficient for velocity
      temperature_verticaldiffusion_background =  # [m2/s]  vertical background diffusion coefficient for temperature
      salinity_verticaldiffusion_background =  # [m2/s]  vertical background diffusion coefficient for salinity
      tracer_convection_mixingcoefficient =  # max vertical tracer diffusion for convection used in case of instability
      convection_instabilitythreshold =  # used in update_ho_params - default=-5e-8
      richardsondiffusion_threshold =  # used in update_ho_params - default=+5e-8
      tracer_richardsoncoeff =  # factor for vertical diffusion coefficient in PP scheme
      velocity_richardsoncoeff =  # factor for vertical viscosity coefficient in PP scheme
      bottom_drag_coeff =  # default=2.5E-3; active for i_bc_veloc_bot=1
      use_wind_mixing =  # true: use wind mixing scheme in MPIOM-type PP-scheme
      lambda_wind =
    [[[ocean_gentmcwilliamsredi_nml]]]
      gmredi_configuration = 0 # 0=cartesian diffusion; 1=GM-Redi: bolus advection + isopycnal diffusion
      tapering_scheme = 1
      gmredi_usesrelativemaxslopes = false
      s_max = 1.0e-3
      s_d = 1.0e-4
      k_tracer_gm_kappa_parameter = 0.0
      k_tracer_isoneutral_parameter = 0.0 # value for cell-based cartesian diffusion - mpiom: 1000/400km = 400/160km
      k_tracer_dianeutral_parameter = 0.0
      switch_off_diagonal_vert_expl = true
      gmredi_combined_diagnostic = false
      revert_vertical_recon_and_transposed = true
      slope_calc_via_temperture_salinity = true
      include_slope_squared_implicit = true # think of l_with_vert_tracer_diffusion
      switch_on_tapering_horizontal_diffusion = true
    [[[ocean_physics_nml]]]
      i_sea_ice = 1 # 0 = no sea ice; 1 = sea ice model on; default=1
    [[[ocean_forcing_nml]]]
      iforc_oce = 14 # ocean forcing: 14 from coupling via YAC
      forcing_windstress_u_type = 2 # 0: zero wind stress, 1: read from file, 2: none
      forcing_windstress_v_type = 2 # 0: zero wind stress, 1: read from file, 2: none
      limit_seaice = true # default: TRUE
      limit_seaice_type = 1
      seaice_limit = 6.0 # hard limit set to 80% of upper layer for sea ice
      lfix_salt_content = false # fix global ocean+ice salt content to constant (false)
      lcheck_salt_content = false
      atm_pressure_included_in_icedyn = true
      atm_pressure_included_in_ocedyn = true
      jerlov_atten = 0.08
      jerlov_bluefrac = 0.36
      lswr_jerlov = true
      limit_elevation = false
      tides_mod = 1
      use_tides = false
      type_surfrelax_temp =  # -1: use net surface heat flux from atmosphere; 0: no relaxation used; 1: relaxation switched on for reading (init_oce_relax=1) or some testcases only
      forcing_enable_freshwater = # enable/disable freshwater flux
    [[[ocean_diagnostics_nml]]]
      diagnose_for_heat_content = true
      diagnose_for_horizontalvelocity = false
      diagnose_for_tendencies = false
      diagnostics_level = 1
    [[[io_nml]]]
      restart_file_type = 5
      restart_write_mode = joint procs multifile
      write_last_restart = true
    [[[ocean_initialconditions_nml]]]  # Initalize from climatology
      initial_salinity_type = 1
      initial_temperature_type = 1
      initialize_fromrestart = false


  [[NAMELIST_atm, NAMELIST_oce]]
    [[[sea_ice_nml]]]
      albedow_sim = 0.10
      albi = 0.70
      albim = 0.68
      albs = 0.81
      albsm = 0.77
      cd_io = 5.5e-3
      delta_min = 2.0e-09
      i_ice_dyn = 1
      i_ice_therm = 1
      leadclose_1 = 0.25
      leadclose_2n = 0.0
      luse_replacement_pressure = true




[files]
  [[atmosphere]]
    [[[mapped]]]
      [[[[initial]]]]
        .sub_dir = initial_conditions/r0100
        ifs2icon.nc = ifs2icon_1990010100_${ATMO_GRID_ID}_${ATMO_GRID_TYPE}_G.nc
      [[[[ozone]]]]
        .offsets = -1, 0, 1
        .set revision = r0100
        .set label = historical
        .sub_dir = ozone/$${revision}
        bc_ozone_%year.nc = bc_ozone_$${label}_1990.nc
      [[[[ocean_surface]]]]
        .sub_dir = sst_and_seaice/r0100
        bc_sic.nc = bc_sic_1989-1991.nc
        bc_sst.nc = bc_sst_1989-1991.nc
      [[[[aerosols]]]]
        .sub_dir = aerosol_kinne/r0100
        bc_aeropt_kinne_lw_b16_coa.nc = .
        bc_aeropt_kinne_sw_b14_coa.nc = .
        bc_aeropt_kinne_sw_b14_fin_1989.nc = bc_aeropt_kinne_sw_b14_fin_1990.nc
        bc_aeropt_kinne_sw_b14_fin_1990.nc = .
        bc_aeropt_kinne_sw_b14_fin_1991.nc = bc_aeropt_kinne_sw_b14_fin_1990.nc
    [[[restart]]]
      multifile_restart_atm.mfr = ${EXP_ID}_restart_atm_$${start_stamp}Z.mfr
      restart_atm_DOM01.nc =
    [[[model]]]
      [[[[data]]]]
        .sub_dir = data
        lsdata.nc =
        rrtmgp-cloud-optics-coeffs-lw.nc = ECHAM6_CldOptProps_rrtmgp_lw.nc
        rrtmgp-cloud-optics-coeffs-sw.nc = ECHAM6_CldOptProps_rrtmgp_sw.nc
      [[[[rrtmgp]]]]
        .sub_dir = data
        coefficients_lw.nc = rrtmgp-gas-lw-g128.nc
        coefficients_sw.nc = rrtmgp-gas-sw-g112.nc
    [[[independent]]]
      .sub_dir = common
      bc_greenhouse_gases.nc = greenhouse_gases/greenhouse_$SCENARIO.nc
      [[[[solar_irradiance]]]]
        .sub_dir = solar_radiation
        bc_solar_irradiance_sw_b14.nc = swflux_14band_cmip6_1850-2299-v3.2.nc

  [[land]]
    [[[mapped]]]
      .sub_dir = $ATMO_GRID_ID-$OCEAN_GRID_ID/land/r0100
      ic_land_soil.nc = .
      bc_land_frac.nc = .
      bc_land_phys.nc = .
      bc_land_soil.nc = .
      bc_land_sso.nc = .
    [[[hydro]]]
      .sub_dir = $ATMO_GRID_ID-$OCEAN_GRID_ID/hd/r0100
      bc_land_hd.nc = hdpara_${atmo_grid}_${ATMO_GRID_ID}_${OCEAN_GRID_ID}_mc_maxl_s_v1.nc
      ic_land_hd.nc = hdstart_${atmo_grid}_${ATMO_GRID_ID}_${OCEAN_GRID_ID}_mc_maxl_s_v1.nc
    [[[data]]]
      .base_dir = /work/bk1341/k202123/mkexp_for_hybrid/build_intel/externals/jsbach/data
      lctlib_nlct21.def = .

  [[ocean]]
    [[[grids]]]
      .sub_dir = $OCEAN_GRID_ID
    [[[initial_conditions]]]
      .base_dir = /pool/data/ICON/grids/public/mpim/$OCEAN_GRID_ID/ocean/initial_conditions
      initial_state.nc = ts_phc3.0_annual_icon_icon_grid_${OCEAN_GRID_ID}_${OCEAN_GRID_TYPE}_O_L72.nc
    [[[restart]]]
      .hide = true



[jobs]
  [[run]]
    .trigger = run, intake -w -W, mon -w -W -N
    nodes = 2
    ocean_nodes = 1
    threads_per_task = 4
    time_limit = 00:05:00

  [[run_start]]
    [[[files]]]
      [[[[atmosphere]]]]
        [[[[[restart_data]]]]]
          .hide = true
        [[[[[restart]]]]]
          .hide = true
      [[[[ocean]]]]
        [[[[[restart_data]]]]]
          .hide = true
        [[[[[restart]]]]]
          .base_dir = $OCEAN_PARENT_DIR
          multifile_restart_oce.mfr = ${OCEAN_PARENT_EXP_ID}_restart_oce_${OCEAN_PARENT_DATE}.nc
          restart_oce_DOM01.nc =

  [[mon]]
    time_limit = 30
    mean_op = dayavg
