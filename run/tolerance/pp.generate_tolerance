set -euo pipefail

# This is the generic file that is used to generate probtest tolerances

# This file will be copied on the fly by scripts/experiments/yaml_experiment_test_processor.py
# before adding it with addexp.

# set basic name
probtest_exp=${EXPNAME#generate_tolerance_}

echo "Generate new tolerance data for '$probtest_exp' (using job $EXPNAME)"

export TEST_FILE_TYPES=$("${basedir}/scripts/experiments/get_param_for_exp_by_machine" --experiment "$probtest_exp" --param test_file_types)
TEST_FILE_TYPES="${TEST_FILE_TYPES:-STATS}"
export TEST_FILE_TYPES

# make sure the resulting data and directories are global readable
umask 0022

# path to probtest script
PROBTEST="${basedir}/externals/probtest/probtest.py"

stats_file_name="stats_${probtest_exp}_{member_id}.csv"
default_reference_stats_file_name="stats_${probtest_exp}_ref.csv"
reference_file_name="${basedir}/${probtest_exp}_reference.csv"

if [[ -z "$probtest_exp" ]]; then
    echo "ERROR: \$probtest_exp not set"
    echo "probtest_exp is required for pp.generate_tolerance"
    exit 1
fi

# Set PROBTEST_CONFIG according to initialized json file in yaml_experiment_test_processor.py
export PROBTEST_CONFIG="${basedir}/${probtest_exp}-config.json"

# create stats file for each seed (layer-wise max/min/mean)
"$PROBTEST" stats --ensemble --stats-file-name "$stats_file_name" || exit 3

# store the reference stats file
echo "storing reference ${default_reference_stats_file_name} to ${reference_file_name}"
cp "$default_reference_stats_file_name" "$reference_file_name" || exit 4

has_fof=false
if [[ " ${TEST_FILE_TYPES[@]} " =~ "fof" ]]; then
    has_fof=true

    fof_types=(AIREP PILOT TEMP SYNOP)

    for fof_type in "${fof_types[@]}"; do
        default_reference_fof_file_name="${basedir}/experiments/${probtest_exp}/fof${fof_type}.nc"
        reference_fof_name="${basedir}/${probtest_exp}_fof${fof_type}_reference.nc"

        echo "storing reference ${default_reference_fof_file_name} to ${reference_fof_name}"

        cp "$default_reference_fof_file_name" "$reference_fof_name" || exit 5

    done

    if [[ $BB_NAME == *mixed* ]]; then
        member_type="mixed"
    else
        member_type="double"
    fi
    fof_types_csv=$(IFS=,; echo "${fof_types[*]}")

else
    member_type=""
    fof_types_csv=""
fi

ensemble_files="stats_${probtest_exp}_{member_id}.csv"

tolerance_files="${basedir}/${probtest_exp}_tolerance.csv"

if $has_fof; then

    ensemble_files+=",${basedir}/experiments/${probtest_exp}{member_type}{member_id}/fof{fof_type}.nc"

    tolerance_files+=",${basedir}/${probtest_exp}_tolerance_fof{fof_type}.csv"
fi

"$PROBTEST" tolerance \
    --ensemble-files "$ensemble_files" \
    --tolerance-files "$tolerance_files" \
    ${fof_types_csv:+--fof-types "$fof_types_csv"}\
    ${member_type:+--member-type "$member_type"} \
    || exit 6

exit 0
