 lmsgwam_offline             =                     .FALSE.        ! logical switch for using MS-GWaM in offline mode
 ltest_hprop                 =                      .TRUE.        ! logical switch for horizontal propagation test
 ltest_gcircle               =                      .TRUE.        ! test propagation on great circle
