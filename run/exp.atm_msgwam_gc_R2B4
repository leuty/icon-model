 flux_bs                     =                 0.0025 , 0.0015    ! launch flux bounds at boreal summer
 facgamma                    =                          0.2142857 ! tuning parameter for correction in dispersion relation
 lmvisc                      =                     .FALSE.        ! logical switch for molecular viscosity
 ldiagprof                   =                     .FALSE.        ! diagnostic printouts and data for MATLAB Hovmöller
 mylon                       =                        -10.0       ! lon for ldiagprof
 mylat                       =                        -55.0       ! lat for ldiagprof
 dir_restartfiles            =           '${thisdir}'
/
&gw_source_nml
 cgw_n_source                =                    0        !
cgw_limfactor               =                        1
/
&output_nml
 filetype               = 4
 dom                    = 1
 output_time_unit       = 1
 output_start     = "${start_date}"       ! output_start = output_end
 output_end       = "${end_date}"       ! --> write once only irrespective of
 output_interval  = "${output_interval}"  !     the output interval and
 file_interval    = "${file_interval}"    !     the file interval
 include_last           = .TRUE.
 remap                  = 0                ! output on triangular grid
 output_filename        = "${EXPNAME}_out1"     ! file name base
 filename_format        = "<output_filename>_<datetime2>"
 output_grid            = .TRUE.
 ml_varlist             = 'u','w','temp','pres','rho','z_ifc','z_mc', 'action_mgm_1', 'active_rays_mgm'
/
EOF
