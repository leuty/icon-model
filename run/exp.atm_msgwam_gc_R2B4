#--------------------------------------------------------------------------------------------------
#
# Ray-volume 3D propagation experiment
#
author_list="Alena Kosareva, GUF"
#
#--------------------------------------------------------------------------------------------------
#
# This is a global, idealized test case for the MS-GWaM submodule
# in an isothermal atmosphere. The primary goal is to verify the correctness
# of ray-volume handling procedures and 3D propagation routines by simulating
# the propagation of ray volumes along great circles.
#
#
#--------------------------------------------------------------------------------------------------

# (1) Variables provided by the scripting mechanism

# EXPNAME                       = name of exp. in 'exp.<name>'
# basedir                       = base directory, where src/, run/ etc exist
# icon_data_poolFolder          = base directory, where grids/, input/ and setup/ exist
# nproma                        = blocking length for array dimensioning and inner loop lengths

icon_data_poolFolder="${icon_data_rootFolder:-/pool/data/ICON}"

#--------------------------------------------------------------------------------------------------
# directories with absolute paths

# (2) Set variables needed by the scripting mechanism
thisdir=$(pwd)

# horizontal grid(s)
#
grids_folder=${icon_data_poolFolder}/grids/public/mpim/0013/
#
# global domain
#
dynamics_grid_filename=icon_grid_0013_R02B04_G.nc
atmo_dyn_grids="'${dynamics_grid_filename}',"

# start and end date+time
start_date=${start_date:="1979-01-01T00:00:00Z"}
end_date=${end_date:="1979-01-01T00:16:00Z"}

# output intervals
file_interval="PT8M"
output_interval="PT2M"

# restart intervals
checkpoint_interval="PT8M"
restart_interval="PT16M"


# namelist files
atmo_namelist=NAMELIST_${EXPNAME}_atm

#--------------------------------------------------------------------------------------------------

# (3) Define the model configuration

cat > ${atmo_namelist} << EOF
