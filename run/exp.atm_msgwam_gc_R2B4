 l_log_checks           = .false.
 iorder_sendrecv        = 1
/
&grid_nml
 dynamics_grid_filename = ${atmo_dyn_grids},
 grid_rescale_factor    = 1.0
/
&run_nml
 num_lev                = 300,              ! number of full levels of vertical grid
 dtime                  = 120              ! [s] timestep in seconds
 ltestcase              = .TRUE.           ! run testcase
 ldynamics              = .FALSE.          ! dynamics
 ltransport             = .FALSE.           ! transport
 iforcing               = 3                !
 msg_level              = 10               ! detailed report during integration
 restart_filename = "${EXPNAME}_restart_atm_<rsttime>.nc"
 ltimer                 = .TRUE.
 timers_level           = 10
 output                 = "nml"
 lmsgwam                = .TRUE.        ! main logical switch for using MS-GWaM
/
&dynamics_nml
