# (4) Define the input

# model files
add_required_file ${grids_folder}/planar_one_triangle.nc ./
#
for site in `seq $num_land_sites`
do
  sname=${land_sites[$site-1]}
  sdir=${land_sites_dirs[$site-1]}

  # jsbach namelist file
  add_required_file ${basedir}/run/${jsbach_namelist}_${sname}            ./

  # initial conditions and parameters
  datadir=${lnd_data_InputFolder}/${sdir}
  add_link_file ${datadir}/ic_land_soil.nc                     ./ic_land_soil_${sname}.nc
  add_link_file $datadir/bc_land_phys.nc                       ./bc_land_phys_${sname}.nc
  add_link_file $datadir/bc_land_soil.nc                       ./bc_land_soil_${sname}.nc
  add_link_file $datadir/bc_land_sso.nc                        ./bc_land_sso_${sname}.nc
  add_link_file $datadir/bc_soil_quincy.nc                     ./bc_soil_quincy_${sname}.nc

  dep_datadir=${datadir}/NP_deposition
  add_link_file ${dep_datadir}/bc_land_npdep_quincy_${refyear}.nc  ./bc_land_npdep_quincy_${sname}.nc
  add_link_file $datadir/bc_land_quincy_land_use_static.nc         ./bc_land_use_static_${sname}.nc
  add_link_file $datadir/LUH_harvest_mean_1850-1869.nc             ./bc_land_use_quincy_${sname}.nc
  add_link_file $datadir/bc_land_frac_iq_${npft}pfts_${refyear}.nc ./bc_land_frac_${sname}.nc

  # transient deposition and land-use data
  if [ "${deposition_scheme}" == "transient" ] || [ "${syl_harvest_scheme}" == "transient" ]; then
    start_year=${start_date%%-*}
    end_year=${end_date%%-*}
    year=${start_year}
    while [ ${year} -le ${end_year} ]; do
      if [ "${syl_harvest_scheme}" == "transient" ]; then
        lu_ifile=bc_land_use_quincy_${year}.nc
        lu_ofile=bc_land_use_quincy_${sname}_${year}.nc
        if [ -f "${datadir}"/"${lu_ifile}" ]; then
          add_link_file $datadir/"${lu_ifile}"   ./"${lu_ofile}"
        else
          echo "  ERROR!  QUINCY: "${datadir}"/"${lu_ifile}" not available"
          exit 1
        fi
      fi

      if [ "${deposition_scheme}" == "transient" ]; then
        dep_ofile=bc_land_npdep_quincy_${sname}_${year}.nc
        if [ ${year} -le 2022 ]; then
          dep_ifile=bc_land_npdep_quincy_${year}.nc
        else
          dep_ifile=bc_land_npdep_quincy_2022.nc
        fi
        if [ -f "${dep_datadir}"/"${dep_ifile}" ]; then
          add_link_file "${dep_datadir}"/"${dep_ifile}"   ./"${dep_ofile}"
        else
          echo "  ERROR!  QUINCY: "${dep_datadir}"/"${dep_ifile}" not available"
          exit 1
        fi
      fi
      (( year = year + 1 ))
    done || exit 1
  fi

  if [[ ${with_alcc} = yes ]]; then
    year=${start_date%%-*}
    end_year=$(( ${end_date%%-*} + 1 ))
    while [[ $year -le $end_year ]]; do
      add_link_file ${datadir}/bc_land_frac_iq_${npft}pfts_${year}.nc  ./bc_land_frac_${sname}_${year}.nc
      (( year = year+1 ))
    done
  fi

done

## quincy lctlib
add_link_file ${basedir}/externals/jsbach/data/lctlib_quincy_nlct14.def             ./lctlib_quincy_nlct14.def

# boundary conditions
#
# - well mixed greenhouse gases
add_link_file ${forcingCO2globalFile}                            ./bc_greenhouse_gases.nc
#

# range of years for yearly files
# assume start_date and end_date have the format yyyy-...
start_year=$(( ${start_date%%-*} - 1 ))
end_year=$(( ${end_date%%-*} + 1 ))
if [ ${years_for_cyclic_forcing} -gt 0 ]
then
  [[ ${start_year_for_cyclic_forcing} -eq 9999 ]] || (( start_year=start_year_for_cyclic_forcing - 1 ))
  (( end_year = start_year + years_for_cyclic_forcing + 1 ))
fi
#
# Provide Links to the climate forcing files

year=$start_year
while [ ${year} -le ${end_year} ]; do

  case ${forcing_tag} in
    GSWP3 )
      for site in `seq $num_land_sites`
      do
        sname=${land_sites[$site-1]}
        sdir=${land_sites_dirs[$site-1]}
        forcing_dir=${SEP}/${sdir}/GSWP3-W5E5/data
        add_link_file   ${forcing_dir}/climate_gswp3-w5e5_daily_${year}.nc  ./climate_${sname}_${year}.nc
      done
      ;;
    * )
      add_link_file   Climate_${forcing_tag}_${year}.nc                             ./climate_${year}.nc
      ;;
  esac

  (( year = year+1 ))
done

