set -e

# Validate the number of arguments
if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <scheme> <case>"
    exit 1
fi

scheme=$1
case=$2

# Define file paths
input_file="${scheme}_${case}.nc"
stats_file="${scheme}_${case}_{member_id}"
tolerance_file="tolerance/${scheme}_${case}"
ref_file="${scheme}_${case}_ref"
cur_file="${scheme}_${case}_1"

# Run commands
python @CMAKE_CURRENT_SOURCE_DIR@/../../externals/probtest/probtest.py stats --ensemble --file-id "NetCDF" "${input_file}" --stats-file-name "${stats_file}"
python @CMAKE_CURRENT_SOURCE_DIR@/../../externals/probtest/probtest.py tolerance --stats-file-name "${stats_file}" --tolerance-file-name "${tolerance_file}"
python @CMAKE_CURRENT_SOURCE_DIR@/../../externals/probtest/probtest.py check --input-file-ref "${ref_file}" --input-file-cur "${cur_file}" --tolerance-file-name "${tolerance_file}"

exit 0
