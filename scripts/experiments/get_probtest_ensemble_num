import click
from yaml_experiment_test_processor import ExperimentTestCollection

@click.command()
@click.option("--exp-yml", "exp_yml", type=str, required=True)
@click.option("--test-yml", "test_yml", type=str, required=True)
@click.option("--experiment", "exp", type=str, required=True)
def main(exp_yml, test_yml, exp):
    tests = ExperimentTestCollection(exp_yml, test_yml)
    tests.print_ensemble_num_for_exp(exp)

if __name__ == '__main__':
    main()
